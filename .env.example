# ==============================================================================
# ConsejoScout PWA - Plantilla de Variables de Entorno
# ==============================================================================
# Copiar este archivo a .env.local para desarrollo local y configurar todas las
# variables en Vercel (Project Settings -> Environment Variables).
# NUNCA commitear archivos .env o .env.local con credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# BLOQUE 1: FRONTEND PUBLICO (Prefijo VITE_ - Embebido en el bundle del cliente)
# ADVERTENCIA: Solo incluir valores publicos. Jamas colocar claves privadas aqui.
# ------------------------------------------------------------------------------

# URL del proyecto Supabase (Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica anonima de Supabase (Settings -> API -> Project API keys -> anon)
VITE_SUPABASE_ANON_KEY=tu-supabase-anon-key

# Clave publica VAPID en formato base64url (generada con: npm run generate-vapid)
VITE_VAPID_PUBLIC_KEY=tu-vapid-public-key

# Enlaces institucionales oficiales de Scouts de Argentina (SAAC)
VITE_SAAC_CRUZ_DEL_SUR_URL=https://cruzdelsur.scouts.org.ar
VITE_SAAC_RUMBO_SUR_URL=https://rumbosur.scouts.org.ar
VITE_SAAC_BIBLIOTECA_URL=https://scouts.org.ar/biblioteca
VITE_SAAC_CAMPUS_URL=https://campus.scouts.org.ar

# ------------------------------------------------------------------------------
# BLOQUE 2: SERVIDOR PRIVADO VERCEL Y SCRIPTS CLI (Sin prefijo VITE_)
# Solo accesibles en /api/** (Serverless Functions) y scripts locales/CI.
# ------------------------------------------------------------------------------

# URL del proyecto Supabase para el cliente administrativo de servidor
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave service_role de Supabase (privilegios elevados, omite RLS)
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# Configuracion Web Push VAPID (generar par de claves con: npm run generate-vapid)
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:soporte@consejoscout.org.ar

# Secreto para autenticar ejecuciones del cron /api/push/check-reminders
# Generar con: openssl rand -hex 32
CRON_SECRET=tu-secreto-aleatorio-de-64-caracteres-hex

# Configuracion del pipeline CLI de ingesta normativa (npm run ingest-saac)
# Proveedores soportados: gemini (por defecto, text-embedding-004) | openai (text-embedding-3-small, 768 dims)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=tu-api-key-de-embeddings
